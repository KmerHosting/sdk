{
  "name": "kmerhosting/sdk",
  "description": "Official PHP SDK for the KmerHosting API.",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "KmerHosting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KmerHosting\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
